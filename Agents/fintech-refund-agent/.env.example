# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=refund_agent
POSTGRES_USER=refund
POSTGRES_PASSWORD=refund_secret

# Redis
REDIS_URL=redis://localhost:6379/0

# Kafka (audit log)
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_AUDIT_TOPIC=refund-audit-log

# API
API_HOST=0.0.0.0
API_PORT=8000

# Agent thresholds (tunable by risk team, no redeploy needed)
CONFIDENCE_THRESHOLD=0.85
ESCALATION_THRESHOLD=0.60
MAX_AUTO_REFUND_AMOUNT=500.00
MAX_REFUNDS_PER_24H=5
REFUND_WINDOW_DAYS=30

# LLM
LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=1024
