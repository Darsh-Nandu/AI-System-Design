# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=loop_detector
POSTGRES_USER=loop
POSTGRES_PASSWORD=loop_secret

# Redis
REDIS_URL=redis://localhost:6379/0

# API
API_HOST=0.0.0.0
API_PORT=8000

# Detection thresholds
FINGERPRINT_WINDOW=10
SEMANTIC_THRESHOLD=0.92
SEMANTIC_WINDOW=5
MAX_STEPS=50
MAX_TOKENS=100000
PROGRESS_WINDOW=5
PROGRESS_NOVELTY_THRESHOLD=0.05
CONSECUTIVE_DETECTIONS_FOR_CHECKPOINT=3

# Monitoring agent
MONITOR_POLL_INTERVAL_SECONDS=5
TOOL_TIMEOUT_MULTIPLIER=3.0

# LLM
LLM_MODEL=claude-sonnet-4-6
