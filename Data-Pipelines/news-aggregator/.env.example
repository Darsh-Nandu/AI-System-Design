# ── Kafka ──────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_RAW_ARTICLES=raw-articles
KAFKA_CONSUMER_GROUP=news-workers
KAFKA_NUM_PARTITIONS=12
KAFKA_REPLICATION_FACTOR=1

# ── PostgreSQL ─────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=news_aggregator
POSTGRES_USER=news
POSTGRES_PASSWORD=news_secret

# ── Qdrant ─────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_HOT=articles_hot
QDRANT_COLLECTION_WARM=articles_warm
QDRANT_COLLECTION_COLD=articles_cold

# ── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_FINGERPRINT_TTL_SECONDS=604800  # 7 days

# ── Embedding ──────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ── Deduplication thresholds ───────────────────────────────
DEDUP_EXACT_THRESHOLD=0.97
DEDUP_CLUSTER_THRESHOLD=0.85

# ── Workers ────────────────────────────────────────────────
WORKER_CONCURRENCY=10
WORKER_BATCH_SIZE=50

# ── API ────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# ── Scraper ────────────────────────────────────────────────
SCRAPER_POLL_INTERVAL_SECONDS=30
SCRAPER_REQUEST_TIMEOUT_SECONDS=10

# ── Checker Agent ──────────────────────────────────────────
HOT_CHECKER_INTERVAL_SECONDS=300   # 5 minutes
COLD_ARCHIVE_AFTER_DAYS=7
